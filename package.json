{
  "name": "area",
  "packageManager": "npm@11.6.2",
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "!apps/mobile"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@types/node": "^24.10.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2.6.1"
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.2.6",
    "typescript": "^5.9.3",
    "zod": "^4.1.13"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "dev": "turbo run dev"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "npm run format",
      "npm run lint"
    ]
  }
}
