# Node configuration
NODE_ENV=development

# Server configuration
PORT=3000
BASE_API_URL=http://localhost:$PORT
CRYPT_SECRET_KEY=your_crypt_secret_key

# Frontend configuration
FRONTEND_AUTHORIZE_CALLBACK_URL=http://localhost:3000/your/callback/path

# Database configuration
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=database
MONGO_DATABASE_URL=mongodb
MONGO_URI=mongodb://$MONGO_INITDB_ROOT_USERNAME:$MONGO_INITDB_ROOT_PASSWORD@$MONGO_DATABASE_URL:27017

# 3rd party services (temporary)
GITHUB_TOKEN=your_github_token

# JWT configuration
JWT_ACCESS_TOKEN_SECRET=your_access_token_secret
JWT_REFRESH_TOKEN_SECRET=your_refresh_token_secret
JWT_STATE_TOKEN_SECRET=your_state_token_secret

## 3rd party services

# GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
