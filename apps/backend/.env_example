# Node configuration
NODE_ENV=development

# Server configuration
PORT=3000
BASE_API_URL=http://localhost:$PORT
CRYPT_SECRET_KEY=your_crypt_secret_key
ADMIN_SECRET=your_admin_secret

# Client configuration
WEB_OAUTH_CALLBACK_URL=http://localhost:3000/your/callback/path
MOBILE_OAUTH_CALLBACK_URL=app://your/callback/path

# Database configuration
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=database
MONGO_DATABASE_URL=mongodb
MONGO_URI=mongodb://$MONGO_INITDB_ROOT_USERNAME:$MONGO_INITDB_ROOT_PASSWORD@$MONGO_DATABASE_URL:27017

# JWT configuration
JWT_ACCESS_TOKEN_SECRET=your_access_token_secret
JWT_REFRESH_TOKEN_SECRET=your_refresh_token_secret
JWT_STATE_TOKEN_SECRET=your_state_token_secret

## 3rd party services

# GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Discord
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token

# X
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_CODE_VERIFIER=your_x_code_verifier
